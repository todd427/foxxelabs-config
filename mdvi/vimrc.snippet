
" >>> mdvi
syntax on
filetype plugin on
" set background=dark                 " if vim guesses your terminal wrong (pale boxes behind code)
" Per-language highlighting inside ``` blocks. Off by default: stock vim then
" hides the fence lines and the block loses its uniform background.
" let g:markdown_fenced_languages = ['python', 'sh', 'bash=sh', 'json', 'yaml', 'toml', 'rust', 'javascript', 'sql', 'lua', 'vim']
" let g:markdown_syntax_conceal = 0  " keep ** _ markers visible, still hide <span> tags and URLs
" let g:mdvi_conceal_urls = 0        " never hide link URLs
" let g:mdvi_conceal = 0             " start every file in raw view
" <<< mdvi
